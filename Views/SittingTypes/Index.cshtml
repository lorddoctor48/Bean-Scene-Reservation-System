@model IEnumerable<Project_Assessment_Bean_Scene_Registration_Application.Models.SittingType>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.SittingTitle)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.SittingTitle)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SittingTypeId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SittingTypeId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SittingTypeId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
