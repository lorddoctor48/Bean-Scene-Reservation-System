@model Project_Assessment_Bean_Scene_Registration_Application.Models.Sitting

@{
    ViewData["Title"] = "Delete";
}

<h1 class=" Bean-Scene-h1">Are you sure you want to delete the following sitting record?</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.SittingId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.SittingId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SittingType)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SittingType.SittingTypeId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SittingStartDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SittingStartDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SittingEndDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SittingEndDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SittingStartTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SittingStartTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SittingEndTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SittingEndTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SittingCapacity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SittingCapacity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsClosed)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsClosed)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ClosureDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ClosureDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ClosureReason)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ClosureReason)
        </dd>
    </dl>
    <div class="row mt-4 fs-6">
        <div class="col-md-2">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a></>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <form asp-action="Delete">
                    <input type="hidden" asp-for="SittingId" />
                    <input type="submit" value="Delete" class="btn btn-danger" />
                </form>
            </div>
        </div>
    </div>
</div>
