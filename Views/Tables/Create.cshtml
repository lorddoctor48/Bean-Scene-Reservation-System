@model Project_Assessment_Bean_Scene_Registration_Application.Models.Table

@{
    ViewData["Title"] = "Create";
}



<h1 class="Bean-Scene-h1">Create</h1>

<h2 class=" Bean-Scene-h2">Table</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
