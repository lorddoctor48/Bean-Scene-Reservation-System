            <div class="form-group">
                <label asp-for="TableAreaId" class="control-label"></label>
                <select asp-for="TableAreaId" class="form-control" asp-items="ViewBag.TableAreaId">
                    <option value="">-- Select a Table Area --</option>
                </select>
                @* <input asp-for="Area" class="form-control" /> *@
                <span asp-validation-for="TableAreaId" class="text-danger"></span>
            </div>

            @* <div class="form-group">
                <label asp-for="Reservations" class="control-label"></label>
                <input asp-for="Reservations" class="form-control" />
                <span asp-validation-for="Reservations" class="text-danger"></span>
            </div> *@
            <div class="row mt-4">
                <div class="form-group col">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
                <div class="form-group col">
                    <a asp-action="Index" class=" btn btn-secondary">Back to List</a>
                </div>
            </div>
        </form>
    </div>
