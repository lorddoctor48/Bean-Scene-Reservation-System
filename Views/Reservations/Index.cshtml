@model IEnumerable<Project_Assessment_Bean_Scene_Registration_Application.Models.Reservation>

@{
    ViewData["Title"] = "Index";
}

<h1 class="Bean-Scene-h1">Reservations</h1>

<div class="row fs-6">
    @* <div class="col-md-2">
        <h1>Sitting Types</h1>
    </div> *@
    <div class="col-md-2">
        <p>
            <a asp-controller="Home" asp-action="ManagerDashboard" class="btn btn-secondary">Go Back</a>
        </p>

    </div>
    <div class="col-md-3">
        <p>
            <a asp-action="Create" class="btn btn-primary btn-lg">Add Reservation</a>
        </p>
    </div>
</div>

<hr />
<div class="table-responsive">

    <table class="table">
        <thead>
            <tr>
                <th>
                    Reservation No.
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Sitting)
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.SittingId)
            </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.FirstName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LastName)
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PhoneNo)
            </th> *@
                @* <th>
                @Html.DisplayNameFor(model => model.ReservationDate)
            </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.ReservationStartTime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.ReservationEndTime)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.NumberOfPeople)
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.ReservationSource.SourceTitle)
            </th> *@
                <th>
                    @Html.DisplayNameFor(model => model.Status.StatusTitle)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tables)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ReservationId)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Sitting.Description)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ReservationStartTime)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.ReservationEndTime)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.NumberOfPeople)
                    </td>
                    @* <td>
                    @Html.DisplayFor(model => item.ReservationSource.SourceTitle)
                </td> *@

                    <td>
                        @Html.DisplayFor(model => item.Status.StatusTitle)
                    </td>

                    <td>
                        @string.Join(", ", item.Tables.Select(t => t.TableNo))
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ReservationId" class="btn btn-secondary btn-sm" aria-label="Edit" title="Edit">
                            <i class="bi bi-pencil-fill me-1"></i>
                            Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@item.ReservationId" class="btn btn-secondary btn-sm">
                            <i class="bi bi-file-text"></i>
                            Details
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.ReservationId" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash-fill"></i>
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>