@model Project_Assessment_Bean_Scene_Registration_Application.Models.Reservation

@{
    ViewData["Title"] = "Edit";
}

<h1 class="Bean-Scene-h1">Edit Reservation</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ReservationId" />

            @* <div class="form-group">
                <label asp-for="MemberID"></label>
                <input asp-for="MemberID" class="form-control" />
                <span asp-validation-for="MemberID" class="text-danger"></span>

            </div> *@

            <div class="form-group">
                <label asp-for="SittingId"></label>
                <select asp-for="SittingId" class="form-control" asp-items="ViewBag.SittingId">
                    <option value="">-- Select a Sitting --</option>
                </select>
                <span asp-validation-for="SittingId" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNo"></label>
                <input asp-for="PhoneNo" class="form-control" />
                <span asp-validation-for="PhoneNo" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="ReservationStartTime"></label>
                <input asp-for="ReservationStartTime" class="form-control" />
                <span asp-validation-for="ReservationStartTime" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="ReservationEndTime"></label>
                <input asp-for="ReservationEndTime" class="form-control" />
                <span asp-validation-for="ReservationEndTime" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="NumberOfPeople"></label>
                <input asp-for="NumberOfPeople" class="form-control" />
                <span asp-validation-for="NumberOfPeople" class="text-danger"></span>

            </div>

            <div class="form-group">
                <label asp-for="SourceTitleId"></label>
                <select asp-for="SourceTitleId" class="form-control" asp-items="ViewBag.SourceTitleId">
                    <option value="">-- Select a source --</option>
                </select>
                <span asp-validation-for="SourceTitleId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SpecialRequests"></label>
                <input asp-for="SpecialRequests" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="Notes"></label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="StatusId"></label>
                <select asp-for="StatusId" class="form-control" asp-items="ViewBag.StatusId">
                    @* <select asp-for="StatusId" class="form-control" asp-items="@(ViewBag["StatusId"] as SelectList)"> *@
                    <option value="">-- Select a source --</option>
                </select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div>

            @* <div class="form-group">
                <label asp-for="Tables"></label>
                <select asp-for="Tables" class="form-control" asp-items="ViewBag.TableNo">
                    <option value="">-- Select a source --</option>
                </select>
                <span asp-validation-for="StatusId" class="text-danger"></span>
            </div> *@

            <div class="row mt-4">
                <div class="form-group col">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
                <div class="form-group col">
                    <a asp-action="Index" class=" btn btn-secondary">Back to List</a>
                </div>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <div class="col-md-6">

            <h2 class=" Bean-Scene-h2">Tables assigned</h2>

            <div class="row">
                <form asp-action="AssignTable" class="col d-flex flex-column gap-2">
                    <input type="hidden" name="reservationId" value="@Model.ReservationId" />

                    <div class="form-group">
                        <label for="AssignTableNo" class="control-label">Available Tables</label>
                        <select id="AssignTableNo" name="tableNo" multiple class="form-control" asp-items="ViewBag.UnassignedTablesList"></select>
                        @* <span asp-validation-for="SlotId" class="text-danger"></span> *@
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Assign" class="btn btn-primary" />
                    </div>
                </form>
                <form asp-action="UnassignTable" class="col d-flex flex-column gap-2">
                    <input type="hidden" name="reservationId" value="@Model.ReservationId" />

                    <div class="form-group">
                        <label for="unassignTableNo" class="control-label">Assigned Tables</label>
                        <select id="unassignTableNo" name="tableNo" multiple class="form-control" asp-items="ViewBag.AssignedTablesList"></select>
                        @* <span asp-validation-for="SlotId" class="text-danger"></span> *@
                    </div>

                    <div class="form-group">
                        <input type="submit" value="Unassign" class="btn btn-primary" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}