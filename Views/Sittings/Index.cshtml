@model IEnumerable<Project_Assessment_Bean_Scene_Registration_Application.Models.Sitting>

@{
    ViewData["Title"] = "Index";
}

<h1 class="Bean-Scene-h1">Sittings</h1>

<hr />

<div class="row fs-6">
    @* <div class="col-md-2">
        <h1>Sitting Types</h1>
    </div> *@
    <div class="col-md-2">
        <p>
            <a asp-controller="Home" asp-action="ManagerDashboard" class="btn btn-secondary">Go Back</a>
        </p>

    </div>
    <div class="col-md-3">
        <p>
            <a asp-action="Create" class="btn btn-primary btn-lg">Add Sittings</a>
        </p>
    </div>

    <div class="col-md-3">
        <p>
            <a asp-action="BulkCreateOnRange" class="btn btn-primary btn-lg">Bulk Add Sittings with Range</a>
        </p>
    </div>

</div>

<table class="table">
    <thead>
        <tr>
            @* <th>
                @Html.DisplayNameFor(model => model.SittingId)
            </th> *@

            <th>
                @Html.DisplayNameFor(model => model.SittingDate)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.SittingDate)
            </th> *@
            @* <th>
                @Html.DisplayNameFor(model => model.SittingEndDate)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.SittingStartTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SittingEndTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SittingType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SittingCapacity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsClosed)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.ClosureDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClosureReason)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @* <td> *@
                @*     @Html.DisplayFor(modelItem => item.SittingId)
                </td> *@

                <td>
                    @Html.DisplayFor(modelItem => item.SittingDate)
                </td>
                @* <td>
                    @Html.DisplayFor(modelItem => item.SittingStartDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SittingEndDate)
                </td> *@
                <td>
                    @Html.DisplayFor(modelItem => item.SittingStartTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SittingEndTime)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SittingType.SittingTitle)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SittingCapacity)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsClosed)
                </td>
                @* <td>
                    @Html.DisplayFor(modelItem => item.ClosureDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ClosureReason)
                </td> *@
                <td>
                    <a asp-action="Edit" asp-route-id="@item.SittingId" class="btn btn-secondary btn-sm" aria-label="Edit" title="Edit">
                        <i class="bi bi-pencil-fill me-1"></i>
                        Edit
                    </a>
                    <a asp-action="Details" asp-route-id="@item.SittingId" class="btn btn-secondary btn-sm" >
                        <i class="bi bi-file-text"></i>
                        Details
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.SittingId" class="btn btn-danger btn-sm">
                        <i class="bi bi-trash-fill"></i>
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
