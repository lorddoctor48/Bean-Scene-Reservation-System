@model Project_Assessment_Bean_Scene_Registration_Application.Models.ReservationSource

@{
    ViewData["Title"] = "Delete";
}

<h1 class="Bean-Scene-h1">Are you sure you want to delete the @(Model.SourceTitle) reservation source?</h1>

<div class="row mt-4 fs-6">
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a></>
    </div>

    <div class="col-md-2">
        <div class="form-group">
            <form asp-action="Delete">
                <input type="hidden" asp-for="SourceTitleId" />
                <input type="submit" value="Delete" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>
