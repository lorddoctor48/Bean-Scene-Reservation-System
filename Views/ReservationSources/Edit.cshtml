@model Project_Assessment_Bean_Scene_Registration_Application.Models.ReservationSource

@{
    ViewData["Title"] = "Edit";
}

<h1 class="Bean-Scene-h1">Edit Reservation Source</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SourceTitleId" />
            <div class="form-group">
                <label asp-for="SourceTitle" class="control-label"></label>
                <input asp-for="SourceTitle" class="form-control" autofocus />
                <span asp-validation-for="SourceTitle" class="text-danger"></span>
            </div>
            <div class="row mt-4 justify-content-center">

                <div class="col">
                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                </div>

                <div class="col">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a></>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
