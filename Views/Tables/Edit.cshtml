@model Project_Assessment_Bean_Scene_Registration_Application.Models.Table

@{
    ViewData["Title"] = "Edit";
}

<h1 class="Bean-Scene-h1">Edit Table</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="TableNo" />
            <div class="form-group">
                <input type ="hidden" asp-for="TableNo"/>
                <label asp-for="TableNo" class="control-label"></label>
                <input asp-for="TableNo" class="form-control" disabled />
                <span asp-validation-for="TableNo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TableAreaId" class="control-label"></label>
                <select asp-for="TableAreaId" class="form-control" asp-items="ViewBag.TableAreaId">
                    <option value="">-- Select a Table Area --</option>
                </select>
                @* <input asp-for="Area" class="form-control" /> *@
                <span asp-validation-for="TableAreaId" class="text-danger"></span>
            </div>
            <div class="row mt-4 justify-content-center">
                <div class="col">
                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                </div>

                <div class="col">
                    <a asp-action="Index" class="btn btn-secondary">Back to List</a></>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}