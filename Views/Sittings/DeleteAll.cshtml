}

<h1 class=" Bean-Scene-h1">Are you sure you want to delete all sitting records?</h1>
<h2 class="Bean-Scene-h2">This action cannot be undone</h2>

<div class="row mt-4 fs-6">
    <div class="col-md-2">
        <a asp-action="Index" class="btn btn-secondary">Cancel</a></>
    </div>

    <div class="col-md-2">
        <div class="form-group">
            <form asp-action="DeleteAll">
                <input type="hidden" asp-for="SittingId" />
                <input type="submit" value="Delete" class="btn btn-danger" />
            </form>
        </div>
    </div>
</div>
