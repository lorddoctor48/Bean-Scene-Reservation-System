@model IEnumerable<Project_Assessment_Bean_Scene_Registration_Application.Models.Reservation>

@{
    ViewData["Title"] = "My reservations";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Make reservation</a>
</p>

<p>Here is a list of all of your previous reservations with us, showing the most recent first.</p>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Sitting)
                </th>
                <th>
                    Reservation Time
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.SittingId)
                </th>
                <th>
                    # People
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.PhoneNo)
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.Note)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th> *@
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.ReservationId)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Sitting.SittingDate)
                        -
                        @Html.DisplayFor(modelItem => item.Sitting.SittingType)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ReservationStartTime)
                        -
                        @Html.DisplayFor(modelItem => item.ReservationEndTime)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Sitting.SittingType)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.NumberOfPeople)
                    </td>
                    <td class="status-td status-@item.Status.ToString().ToLower()">
                        @Html.DisplayFor(modelItem => item.Status)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.FullName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td class="text-nowrap">
                        @Html.DisplayFor(modelItem => item.PhoneNo)
                    </td>
                    @* <td>
                @Html.DisplayFor(modelItem => item.Note)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.User.Id)
            </td> *@
                    <td class="d-flex gap-1">
                        @* <a asp-action="Edit" asp-route-id="@item.Id"
                    class="btn btn-sm btn-secondary" title="Edit">
                    <i class="bi bi-pencil-fill" aria-label="Edit"></i>
                </a> *@
                        <a href="#"
                           class="btn btn-sm btn-secondary" title="Cancel">
                            <i class="bi bi-pencil-fill" aria-label="Cancel"></i>
                            Cancel
                        </a>
                        @* <a asp-action="Delete" asp-route-id="@item.Id"
                    class="btn btn-sm btn-danger" title="Delete">
                    <i class="bi bi-trash-fill" aria-label="Delete"></i>
                </a> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>